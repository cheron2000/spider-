PORT=4000
DASHBOARD_ORIGIN=http://localhost:5173

# Durable state
# SPIDER_DB_PATH=services/api/data/spider.db

# Peer messaging; replace with a unique random secret (32+ random bytes).
SPIDER_AGENT_API_KEY=replace-me-with-a-long-random-secret
# Coordinator plan management and final review; use a distinct secret.
SPIDER_COORDINATOR_API_KEY=replace-me-with-a-different-long-random-secret

# Provider runtime lifecycle. All six adapters default to offline until enabled/configured.
SPIDER_PROVIDER_POLL_INTERVAL_MS=30000

# Local CLI adapters require a dedicated, existing workspace per provider.
# The API process runs that provider CLI inside the selected workspace.
SPIDER_ANTIGRAVITY_ENABLED=false
SPIDER_ANTIGRAVITY_COMMAND=agy
SPIDER_ANTIGRAVITY_WORKSPACE=
SPIDER_ANTIGRAVITY_TIMEOUT_MS=300000
SPIDER_ANTIGRAVITY_PASSTHROUGH_ENV=

SPIDER_CODEX_ENABLED=false
SPIDER_CODEX_COMMAND=codex
SPIDER_CODEX_WORKSPACE=
SPIDER_CODEX_TIMEOUT_MS=300000
SPIDER_CODEX_SANDBOX=workspace-write
SPIDER_CODEX_PASSTHROUGH_ENV=

SPIDER_COPILOT_ENABLED=false
SPIDER_COPILOT_COMMAND=copilot
SPIDER_COPILOT_WORKSPACE=
SPIDER_COPILOT_TIMEOUT_MS=300000
SPIDER_COPILOT_PASSTHROUGH_ENV=

SPIDER_KIRO_ENABLED=false
SPIDER_KIRO_COMMAND=kiro-cli
SPIDER_KIRO_WORKSPACE=
SPIDER_KIRO_TIMEOUT_MS=300000
SPIDER_KIRO_PASSTHROUGH_ENV=

# Manus uses its official task API. API keys stay server-side.
SPIDER_MANUS_ENABLED=false
MANUS_API_KEY=
SPIDER_MANUS_TIMEOUT_MS=300000
SPIDER_MANUS_POLL_MS=5000

# Replit is connected through an explicitly deployed/authenticated bridge.
# HTTP is only accepted for localhost; use HTTPS for remote bridges.
SPIDER_REPLIT_ENABLED=false
SPIDER_REPLIT_BRIDGE_URL=
SPIDER_REPLIT_BRIDGE_TOKEN=
SPIDER_REPLIT_TIMEOUT_MS=300000

# Manus and Replit bridge permit bounded concurrent remote tasks (1–3).
# Local CLI adapters are limited to one active task per configured workspace.
# SPIDER_MANUS_MAX_CONCURRENT_TASKS=1
# SPIDER_REPLIT_MAX_CONCURRENT_TASKS=1

# Explicitly name any extra environment variables a CLI process must receive.
# Default child environment is an allowlist and does not inherit every API secret.
# Example: SPIDER_CODEX_PASSTHROUGH_ENV=OPENAI_API_KEY,CODEX_HOME
# Example: SPIDER_COPILOT_PASSTHROUGH_ENV=GH_TOKEN,COPILOT_GITHUB_TOKEN

GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo
GITHUB_WEBHOOK_SECRET=
